-- 13. Identify hospitals with highest recommendation scores

SELECT
    facility_id,
    facility_name,
    state,
    nurse_communication,
    doctor_communication,
    medication_communication,
    discharge_information,
    cleanliness,
    quietness,
    recommend_score
FROM hospital_experience
WHERE recommend_score IS NOT NULL
ORDER BY recommend_score DESC
LIMIT 10;


-- 14. Compare patient experience across recommendation quartiles

WITH ranked_hospitals AS (
    SELECT
        *,
        NTILE(4) OVER (
            ORDER BY recommend_score
        ) AS recommendation_quartile
    FROM hospital_experience
    WHERE recommend_score IS NOT NULL
)

SELECT
    recommendation_quartile,
    COUNT(*) AS hospital_count,
    ROUND(AVG(nurse_communication), 2) AS avg_nurse_communication,
    ROUND(AVG(doctor_communication), 2) AS avg_doctor_communication,
    ROUND(AVG(medication_communication), 2) AS avg_medication_communication,
    ROUND(AVG(discharge_information), 2) AS avg_discharge_information,
    ROUND(AVG(cleanliness), 2) AS avg_cleanliness,
    ROUND(AVG(quietness), 2) AS avg_quietness,
    ROUND(AVG(recommend_score), 2) AS avg_recommend_score
FROM ranked_hospitals
GROUP BY recommendation_quartile
ORDER BY recommendation_quartile;

-- 15. Compare average recommendation scores by state

SELECT
    state,
    COUNT(*) AS hospital_count,
    ROUND(AVG(recommend_score), 2) AS avg_recommend_score,
    ROUND(AVG(nurse_communication), 2) AS avg_nurse_communication,
    ROUND(AVG(doctor_communication), 2) AS avg_doctor_communication
FROM hospital_experience
WHERE recommend_score IS NOT NULL
GROUP BY state
HAVING COUNT(*) >= 20
ORDER BY avg_recommend_score DESC;

-- 16. Measure experience score differences between recommendation groups

WITH ranked_hospitals AS (
    SELECT
        *,
        NTILE(4) OVER (
            ORDER BY recommend_score
        ) AS recommendation_quartile
    FROM hospital_experience
    WHERE recommend_score IS NOT NULL
)

SELECT
    ROUND(
        AVG(CASE WHEN recommendation_quartile = 4 THEN nurse_communication END)
        -
        AVG(CASE WHEN recommendation_quartile = 1 THEN nurse_communication END),
        2
    ) AS nurse_communication_gap,

    ROUND(
        AVG(CASE WHEN recommendation_quartile = 4 THEN doctor_communication END)
        -
        AVG(CASE WHEN recommendation_quartile = 1 THEN doctor_communication END),
        2
    ) AS doctor_communication_gap,

    ROUND(
        AVG(CASE WHEN recommendation_quartile = 4 THEN medication_communication END)
        -
        AVG(CASE WHEN recommendation_quartile = 1 THEN medication_communication END),
        2
    ) AS medication_communication_gap,

    ROUND(
        AVG(CASE WHEN recommendation_quartile = 4 THEN discharge_information END)
        -
        AVG(CASE WHEN recommendation_quartile = 1 THEN discharge_information END),
        2
    ) AS discharge_information_gap,

    ROUND(
        AVG(CASE WHEN recommendation_quartile = 4 THEN cleanliness END)
        -
        AVG(CASE WHEN recommendation_quartile = 1 THEN cleanliness END),
        2
    ) AS cleanliness_gap,

    ROUND(
        AVG(CASE WHEN recommendation_quartile = 4 THEN quietness END)
        -
        AVG(CASE WHEN recommendation_quartile = 1 THEN quietness END),
        2
    ) AS quietness_gap

FROM ranked_hospitals;

CREATE TABLE hospital_experience_v2 AS
SELECT
    [Facility ID],
    [Facility Name],
    [State],

    MAX([Number of Completed Surveys]) AS completed_surveys,

    MAX(CASE
        WHEN [HCAHPS Measure ID] = 'H_COMP_1_LINEAR_SCORE'
        THEN [HCAHPS Linear Mean Value]
    END) AS nurse_communication,

    MAX(CASE
        WHEN [HCAHPS Measure ID] = 'H_COMP_2_LINEAR_SCORE'
        THEN [HCAHPS Linear Mean Value]
    END) AS doctor_communication,

    MAX(CASE
        WHEN [HCAHPS Measure ID] = 'H_COMP_5_LINEAR_SCORE'
        THEN [HCAHPS Linear Mean Value]
    END) AS medication_communication,

    MAX(CASE
        WHEN [HCAHPS Measure ID] = 'H_COMP_6_LINEAR_SCORE'
        THEN [HCAHPS Linear Mean Value]
    END) AS discharge_information,

    MAX(CASE
        WHEN [HCAHPS Measure ID] = 'H_CLEAN_LINEAR_SCORE'
        THEN [HCAHPS Linear Mean Value]
    END) AS cleanliness,

    MAX(CASE
        WHEN [HCAHPS Measure ID] = 'H_QUIET_LINEAR_SCORE'
        THEN [HCAHPS Linear Mean Value]
    END) AS quietness,

    MAX(CASE
        WHEN [HCAHPS Measure ID] = 'H_RECMND_LINEAR_SCORE'
        THEN [HCAHPS Linear Mean Value]
    END) AS recommend_score

FROM hcahps_hospital

GROUP BY
    [Facility ID],
    [Facility Name],
    [State];
    
SELECT
    COUNT(*) AS hospitals,
    COUNT(completed_surveys) AS hospitals_with_survey_count,
    MIN(completed_surveys) AS min_surveys,
    MAX(completed_surveys) AS max_surveys,
    AVG(completed_surveys) AS avg_surveys
FROM hospital_experience_v2;

SELECT *
FROM hospital_experience_v2
LIMIT 12;

SELECT
    COUNT(*) AS hospitals,
    COUNT(completed_surveys) AS hospitals_with_survey_count,
    MIN(completed_surveys) AS min_surveys,
    MAX(completed_surveys) AS max_surveys,
    ROUND(AVG(completed_surveys), 1) AS avg_surveys
FROM hospital_experience_v2;

DROP TABLE hospital_experience_v2;

CREATE TABLE hospital_experience_v2 AS
SELECT
    [Facility ID],
    [Facility Name],
    [State],

    MAX(
        CASE
            WHEN [Number of Completed Surveys] NOT IN ('Not Available', 'Not Applicable', '')
            THEN CAST([Number of Completed Surveys] AS INTEGER)
        END
    ) AS completed_surveys,

    MAX(CASE
        WHEN [HCAHPS Measure ID] = 'H_COMP_1_LINEAR_SCORE'
        THEN [HCAHPS Linear Mean Value]
    END) AS nurse_communication,

    MAX(CASE
        WHEN [HCAHPS Measure ID] = 'H_COMP_2_LINEAR_SCORE'
        THEN [HCAHPS Linear Mean Value]
    END) AS doctor_communication,

    MAX(CASE
        WHEN [HCAHPS Measure ID] = 'H_COMP_5_LINEAR_SCORE'
        THEN [HCAHPS Linear Mean Value]
    END) AS medication_communication,

    MAX(CASE
        WHEN [HCAHPS Measure ID] = 'H_COMP_6_LINEAR_SCORE'
        THEN [HCAHPS Linear Mean Value]
    END) AS discharge_information,

    MAX(CASE
        WHEN [HCAHPS Measure ID] = 'H_CLEAN_LINEAR_SCORE'
        THEN [HCAHPS Linear Mean Value]
    END) AS cleanliness,

    MAX(CASE
        WHEN [HCAHPS Measure ID] = 'H_QUIET_LINEAR_SCORE'
        THEN [HCAHPS Linear Mean Value]
    END) AS quietness,

    MAX(CASE
        WHEN [HCAHPS Measure ID] = 'H_RECMND_LINEAR_SCORE'
        THEN [HCAHPS Linear Mean Value]
    END) AS recommend_score

FROM hcahps_hospital

GROUP BY
    [Facility ID],
    [Facility Name],
    [State];
    
SELECT
    COUNT(*) AS hospitals,
    COUNT(completed_surveys) AS hospitals_with_survey_count,
    MIN(completed_surveys) AS min_surveys,
    MAX(completed_surveys) AS max_surveys,
    ROUND(AVG(completed_surveys), 1) AS avg_surveys
FROM hospital_experience_v2;

SELECT
    CASE
        WHEN completed_surveys < 250 THEN 'Small'
        WHEN completed_surveys < 1000 THEN 'Medium'
        ELSE 'Large'
    END AS hospital_size,
    COUNT(*) AS hospitals,
    ROUND(AVG(
        CASE
            WHEN recommend_score != 'Not Available'
            THEN CAST(recommend_score AS REAL)
        END
    ), 2) AS avg_recommendation,
    ROUND(AVG(
        CASE
            WHEN nurse_communication != 'Not Available'
            THEN CAST(nurse_communication AS REAL)
        END
    ), 2) AS avg_nurse_communication
FROM hospital_experience_v2
WHERE completed_surveys != 'Not Available'
GROUP BY hospital_size
ORDER BY
    CASE hospital_size
        WHEN 'Small' THEN 1
        WHEN 'Medium' THEN 2
        WHEN 'Large' THEN 3
    END;
  
