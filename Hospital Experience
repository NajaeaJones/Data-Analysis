
-- 01. Verify raw dataset size, hospitals, and HCAHPS measures

SELECT
    "HCAHPS Measure ID",
    "HCAHPS Question"
FROM hcahps_hospital
WHERE "HCAHPS Measure ID" IN (
    'H_RECMND_LINEAR_SCORE',
    'H_COMP_1_LINEAR_SCORE',
    'H_COMP_2_LINEAR_SCORE',
    'H_COMP_5_LINEAR_SCORE',
    'H_COMP_6_LINEAR_SCORE',
    'H_CLEAN_LINEAR_SCORE',
    'H_QUIET_LINEAR_SCORE'
)
GROUP BY
    "HCAHPS Measure ID",
    "HCAHPS Question"
ORDER BY "HCAHPS Measure ID";

-- 02. Inspect sample rows from the raw HCAHPS dataset

CREATE TABLE hospital_experience AS
SELECT
    "Facility ID" AS facility_id,
    MAX("Facility Name") AS facility_name,
    MAX("State") AS state,

    MAX(
        CASE
            WHEN "HCAHPS Measure ID" = 'H_COMP_1_LINEAR_SCORE'
            THEN CAST(NULLIF(NULLIF("HCAHPS Linear Mean Value", 'Not Applicable'), 'Not Available') AS NUMERIC)
        END
    ) AS nurse_communication,

    MAX(
        CASE
            WHEN "HCAHPS Measure ID" = 'H_COMP_2_LINEAR_SCORE'
            THEN CAST(NULLIF(NULLIF("HCAHPS Linear Mean Value", 'Not Applicable'), 'Not Available') AS NUMERIC)
        END
    ) AS doctor_communication,

    MAX(
        CASE
            WHEN "HCAHPS Measure ID" = 'H_COMP_5_LINEAR_SCORE'
            THEN CAST(NULLIF(NULLIF("HCAHPS Linear Mean Value", 'Not Applicable'), 'Not Available') AS NUMERIC)
        END
    ) AS medication_communication,

    MAX(
        CASE
            WHEN "HCAHPS Measure ID" = 'H_COMP_6_LINEAR_SCORE'
            THEN CAST(NULLIF(NULLIF("HCAHPS Linear Mean Value", 'Not Applicable'), 'Not Available') AS NUMERIC)
        END
    ) AS discharge_information,

    MAX(
        CASE
            WHEN "HCAHPS Measure ID" = 'H_CLEAN_LINEAR_SCORE'
            THEN CAST(NULLIF(NULLIF("HCAHPS Linear Mean Value", 'Not Applicable'), 'Not Available') AS NUMERIC)
        END
    ) AS cleanliness,

    MAX(
        CASE
            WHEN "HCAHPS Measure ID" = 'H_QUIET_LINEAR_SCORE'
            THEN CAST(NULLIF(NULLIF("HCAHPS Linear Mean Value", 'Not Applicable'), 'Not Available') AS NUMERIC)
        END
    ) AS quietness,

    MAX(
        CASE
            WHEN "HCAHPS Measure ID" = 'H_RECMND_LINEAR_SCORE'
            THEN CAST(NULLIF(NULLIF("HCAHPS Linear Mean Value", 'Not Applicable'), 'Not Available') AS NUMERIC)
        END
    ) AS recommend_score

FROM hcahps_hospital

WHERE "HCAHPS Measure ID" IN (
    'H_COMP_1_LINEAR_SCORE',
    'H_COMP_2_LINEAR_SCORE',
    'H_COMP_5_LINEAR_SCORE',
    'H_COMP_6_LINEAR_SCORE',
    'H_CLEAN_LINEAR_SCORE',
    'H_QUIET_LINEAR_SCORE',
    'H_RECMND_LINEAR_SCORE'
)

GROUP BY "Facility ID";

-- 03. Verify selected HCAHPS measures for the analysis

SELECT COUNT(*) AS hospitals
FROM hospital_experience;

-- 04. Create hospital-level patient experience analysis table

SELECT *
FROM hospital_experience
LIMIT 5;

-- 05. Verify number of hospitals in analysis table

SELECT
    COUNT(*) AS total_hospitals,

    COUNT(nurse_communication) AS nurse_available,
    COUNT(doctor_communication) AS doctor_available,
    COUNT(medication_communication) AS medication_available,
    COUNT(discharge_information) AS discharge_available,
    COUNT(cleanliness) AS cleanliness_available,
    COUNT(quietness) AS quietness_available,
    COUNT(recommend_score) AS recommend_available

FROM hospital_experience;

-- 06. Inspect hospital-level analysis table

SELECT
    COUNT(*) AS hospitals_missing_scores
FROM hospital_experience
WHERE recommend_score IS NULL;

-- 07. Check availability of selected HCAHPS scores

SELECT
    state,
    COUNT(*) AS hospitals_missing_scores
FROM hospital_experience
WHERE recommend_score IS NULL
GROUP BY state
ORDER BY hospitals_missing_scores DESC;

-- 08. Identify hospitals missing recommendation scores

SELECT
    COUNT(*) AS hospitals_missing_scores
FROM hospital_experience
WHERE recommend_score IS NULL;

-- 09. Analyze missing HCAHPS scores by state

SELECT
    state,
    COUNT(*) AS hospitals_missing_scores
FROM hospital_experience
WHERE recommend_score IS NULL
GROUP BY state
ORDER BY hospitals_missing_scores DESC;

-- 10. Calculate percentage of hospitals with missing scores by state

SELECT
    state,
    COUNT(*) AS total_hospitals,
    SUM(
        CASE
            WHEN recommend_score IS NULL THEN 1
            ELSE 0
        END
    ) AS missing_scores,
    ROUND(
        100.0 * SUM(
            CASE
                WHEN recommend_score IS NULL THEN 1
                ELSE 0
            END
        ) / COUNT(*),
        1
    ) AS missing_percent
FROM hospital_experience
GROUP BY state
ORDER BY missing_percent DESC;


-- 11. Calculate average score for each patient experience measure

SELECT
    ROUND(AVG(nurse_communication), 2) AS avg_nurse_communication,
    ROUND(AVG(doctor_communication), 2) AS avg_doctor_communication,
    ROUND(AVG(medication_communication), 2) AS avg_medication_communication,
    ROUND(AVG(discharge_information), 2) AS avg_discharge_information,
    ROUND(AVG(cleanliness), 2) AS avg_cleanliness,
    ROUND(AVG(quietness), 2) AS avg_quietness,
    ROUND(AVG(recommend_score), 2) AS avg_recommend_score
FROM hospital_experience;

-- 12. Measure relationship between patient experience and recommendation

SELECT
    'Nurse Communication' AS measure,
    ROUND(
        (
            COUNT(*) * SUM(nurse_communication * recommend_score)
            - SUM(nurse_communication) * SUM(recommend_score)
        )
        /
        SQRT(
            (
                COUNT(*) * SUM(nurse_communication * nurse_communication)
                - SUM(nurse_communication) * SUM(nurse_communication)
            )
            *
            (
                COUNT(*) * SUM(recommend_score * recommend_score)
                - SUM(recommend_score) * SUM(recommend_score)
            )
        ),
        3
    ) AS correlation
FROM hospital_experience
WHERE nurse_communication IS NOT NULL
  AND recommend_score IS NOT NULL

UNION ALL

